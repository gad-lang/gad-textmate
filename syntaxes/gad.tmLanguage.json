{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gad",
  "scopeName": "source.gad",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#specials"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.documentation.block.gad",
          "begin": "/\\*\\*\\*",
          "end": "\\*\\*\\*/\\s*$",
          "patterns": [
            {
              "include": "#docmarkup"
            }
          ]
        },
        {
          "name": "comment.documentation.block.gad",
          "begin": "/\\*\\*",
          "end": "\\*\\*/\\s*$",
          "patterns": [
            {
              "include": "#docmarkup"
            }
          ]
        },
        {
          "name": "comment.documentation.line.gad",
          "match": "///(?!/).*$"
        },
        {
          "name": "comment.line.double-slash.gad",
          "match": "//.*$"
        },
        {
          "name": "comment.block.gad",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "docmarkup": {
      "patterns": [
        {
          "name": "markup.inline.raw.string.gad",
          "match": "`[^`\\n]+`"
        },
        {
          "name": "markup.bold.gad",
          "match": "\\*\\*(?=\\S)[^*\\n]+?(?\u003c=\\S)\\*\\*"
        },
        {
          "name": "markup.bold.gad",
          "match": "(?\u003c![\\w])__(?=\\S)[^_\\n]+?(?\u003c=\\S)__(?![\\w])"
        },
        {
          "name": "markup.italic.gad",
          "match": "(?:^|(?\u003c=[\\s(]))\\*(?=\\S)[^*\\n]+?(?\u003c=\\S)\\*(?=[\\s).,;:!?]|$)"
        },
        {
          "name": "markup.italic.gad",
          "match": "(?\u003c![\\w])_(?=\\S)[^_\\n]+?(?\u003c=\\S)_(?![\\w])"
        },
        {
          "name": "markup.heading.gad",
          "match": "^\\s*#{1,6}\\s+.*$"
        },
        {
          "match": "(\\[)([^\\]\\n]+)(\\])(\\()([^)\\n]+)(\\))",
          "captures": {
            "2": {
              "name": "string.other.link.title.gad"
            },
            "5": {
              "name": "markup.underline.link.gad"
            }
          }
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.gad",
      "contentName": "meta.embedded.gad",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "$self"
        }
      ],
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.gad"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.gad"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gad",
          "match": "\\b(?:deferb_err|defer_err|deferb_ok|continue|defer_ok|finally|delete|export|deferb|global|import|return|break|defer|catch|const|match|param|embed|throw|meti|else|prop|enum|func|with|ain|raw|met|env|try|var|for|in|if)\\b"
        },
        {
          "name": "keyword.control.gad",
          "match": "\\b(?:class|mixin)\\b(?=\\s*\\{|\\s+[A-Za-z_]\\w*\\s*\\{)"
        },
        {
          "name": "keyword.control.gad",
          "match": "\\binterface\\b(?=\\s*[\\{\\[]|\\s+[A-Za-z_]\\w*\\s*\\{)"
        },
        {
          "name": "constant.language.gad",
          "match": "\\b(?:false|true|nil|yes|no)\\b"
        },
        {
          "name": "constant.language.gad",
          "match": "\\b(?:STDERR|STDOUT|STDIN)\\b"
        },
        {
          "name": "support.function.gad",
          "match": "\\b(?:namedParamTypeCheck|iteratorInput|vmPushWriter|vmPopWriter|sortReverse|isIterator|isSyncDict|StaticType|implements|isCallable|isFunction|isIterable|addMethod|enumerate|rawCaller|typeName|userData|isRawStr|contains|obstart|println|collect|isError|sprintf|toArray|isFloat|iterate|isArray|isBytes|repeat|filter|isBool|isChar|printf|typeof|isUint|values|isDict|reduce|isStr|Mixin|dcopy|items|chars|stdio|isInt|close|obend|flush|print|isNil|Class|write|copy|repr|sort|cast|each|read|wrap|keys|cap|len|map|is)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.gad",
          "match": "\\b0[xX][0-9a-fA-F]+\\b|\\b\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?[uUdD]?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.gad",
          "match": ":::|::|\\?\\?=?|\\.\\.|=\u003e|:=|\\|\\||\u0026\u0026|\\*\\*=?|\u003c\u003c\u003c?=?|\u003e\u003e\u003e?=?|\u0026\\^=?|%%=?|===?|!==?|[-+*/%\u0026|^!\u003c\u003e=]=?|[~?:]"
        }
      ]
    },
    "specials": {
      "patterns": [
        {
          "name": "variable.language.gad",
          "match": "@[A-Za-z_$][\\w$]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.interpolated.gad",
          "begin": "#\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.gad",
              "match": "\\\\."
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.interpolated.gad",
          "begin": "#\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gad",
              "match": "\\\\."
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.raw.interpolated.gad",
          "begin": "#`",
          "end": "`",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.triple.gad",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.raw.gad",
          "begin": "```",
          "end": "```"
        },
        {
          "name": "string.quoted.double.gad",
          "begin": "[bh]?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gad",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.raw.gad",
          "begin": "[bh]?`",
          "end": "`"
        },
        {
          "name": "string.quoted.single.gad",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.gad",
              "match": "\\\\."
            }
          ]
        }
      ]
    }
  }
}
